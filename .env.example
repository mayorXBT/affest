NEXT_PUBLIC_AFFEST_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_DEMO_STABLE_TOKEN_ADDRESS=
NEXT_PUBLIC_DEMO_RISK_TOKEN_ADDRESS=
NEXT_PUBLIC_DEMO_SWAP_ADAPTER_ADDRESS=
NEXT_PUBLIC_SEPOLIA_WETH_ADDRESS=

# Server-only chain endpoints.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
SEPOLIA_RPC_URL=
ATTESTCOIN_PROOF_API_URL=https://prover.cc3-testnet.creditcoin.network

# Server-only persistence and authentication.
