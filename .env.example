AFFEST_ATTESTATION_VERIFIER_ADDRESS=
AFFEST_VAULT_FACTORY_ADDRESS=
AFFEST_STRATEGY_MANAGER_ADDRESS=
AFFEST_EXECUTOR_ADDRESS=
DEMO_STABLE_TOKEN_ADDRESS=
DEMO_RISK_TOKEN_ADDRESS=
DEMO_SWAP_ADAPTER_ADDRESS=

