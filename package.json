      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@types/node": "24.3.0",
    "pnpm": "10.15.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
